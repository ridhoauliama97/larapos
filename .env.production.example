# Point of Sales — production .env template for docker compose deploy.
# Copy to .env.production, fill the secrets, then: docker compose --env-file .env.production up -d --build

APP_NAME="Point of Sales"
APP_ENV=production
APP_KEY=
# Generate your own key before deploying: docker compose run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080
APP_VERSION=v2.10.5
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

AUTH_PUBLIC_REGISTRATION=false
SESSION_SECURE_COOKIE=true

# Local HTTP-only testing (skip the HTTPS baseline warning). Remove for real HTTPS deploys.
SECURITY_BASELINE_ALLOW_HTTP=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# --- PostgreSQL (matches the `postgres` service in docker-compose.yml) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=point_of_sales
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=pos

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Midtrans / Xendit webhooks need a publicly reachable APP_URL
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

SCRAMBLE_DOCS_TOKEN=

WA_SERVICE_URL=http://host.docker.internal:3001

# PDF generation (spatie/laravel-pdf + Gotenberg engine bundled in the app container).
# There is NO gotenberg service in docker-compose.yml: the engine's static binaries are
# copied into the `app` image and started on port 3000 by docker/entrypoint.sh.
# So this URL is a loopback address inside the app container, not a service hostname.
LARAVEL_PDF_DRIVER=gotenberg
GOTENBERG_URL=http://localhost:3000

VITE_APP_NAME="${APP_NAME}"

# --- docker compose infra passwords (read by compose, not the app) ---
POSTGRES_DB=point_of_sales
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
APP_PORT=8080
